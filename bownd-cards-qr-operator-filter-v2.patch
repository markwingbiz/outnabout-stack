diff --git a/bownd/components/ui/Barcode.tsx b/bownd/components/ui/Barcode.tsx
new file mode 100644
index 0000000..b4dcd01
--- /dev/null
+++ b/bownd/components/ui/Barcode.tsx
@@ -0,0 +1,95 @@
+// bownd/components/ui/Barcode.tsx
+// REAL Code 128 barcode rendering (Code 128-B, ISO/IEC 15417) via the
+// dependency-free encoder in lib/code128.ts, drawn with react-native-svg.
+// No fake bars, no placeholder image: an empty/invalid value renders an
+// honest "No code available" state instead of a barcode.
+import React, { useMemo } from "react";
+import { StyleSheet, Text, View } from "react-native";
+import Svg, { Rect } from "react-native-svg";
+
+import { encodeCode128B, isEncodableCode128B } from "../../lib/code128";
+
+const QUIET_ZONE_MODULES = 10; // mandatory 10x quiet zone on each side
+
+type Props = {
+  /** The exact string encoded in the barcode. Rendered only when non-empty and valid. */
+  value: string;
+  width?: number;
+  height?: number;
+  /** Human-readable text under the bars. Defaults to the encoded value. */
+  showText?: boolean;
+  barColor?: string;
+  backgroundColor?: string;
+};
+
+export function Barcode({
+  value,
+  width = 280,
+  height = 64,
+  showText = true,
+  barColor = "#111111",
+  backgroundColor = "#ffffff",
+}: Props) {
+  const runs = useMemo(() => {
+    if (!isEncodableCode128B(value)) return null;
+    try {
+      return encodeCode128B(value);
+    } catch {
+      return null;
+    }
+  }, [value]);
+
+  if (!runs) {
+    return (
+      <View style={[styles.empty, { width, backgroundColor }]}>
+        <Text style={styles.emptyText}>No code available</Text>
+      </View>
+    );
+  }
+
+  const dataModules = runs.reduce((sum, r) => sum + r.modules, 0);
+  const totalModules = dataModules + QUIET_ZONE_MODULES * 2;
+  const unit = width / totalModules;
+  let x = QUIET_ZONE_MODULES * unit;
+  const bars: React.ReactElement[] = [];
+  runs.forEach((run, i) => {
+    if (run.black) {
+      bars.push(
+        <Rect
+          key={i}
+          x={x}
+          y={0}
+          width={run.modules * unit}
+          height={height}
+          fill={barColor}
+        />
+      );
+    }
+    x += run.modules * unit;
+  });
+
+  return (
+    <View style={[styles.wrap, { width, backgroundColor }]}>
+      <Svg width={width} height={height} viewBox={`0 0 ${width} ${height}`}>
+        {bars}
+      </Svg>
+      {showText && (
+        <Text style={styles.text} numberOfLines={1}>
+          {value}
+        </Text>
+      )}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  wrap: { borderRadius: 10, paddingHorizontal: 8, paddingVertical: 8, alignItems: "center" },
+  text: { marginTop: 6, fontSize: 11, fontWeight: "700", color: "#111111" },
+  empty: {
+    borderRadius: 10,
+    paddingVertical: 16,
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  emptyText: { fontSize: 12, fontWeight: "700", color: "#514a5a" },
+});
diff --git a/bownd/components/ui/CardBackground.tsx b/bownd/components/ui/CardBackground.tsx
new file mode 100644
index 0000000..7b06081
--- /dev/null
+++ b/bownd/components/ui/CardBackground.tsx
@@ -0,0 +1,42 @@
+// bownd/components/ui/CardBackground.tsx
+// Card background image + readability scrim. Wraps card content in an
+// ImageBackground (TEMP placeholder art or a real photo — see
+// lib/placeholders.ts) with a bottom-weighted dark gradient so title text
+// stays readable over the image. The scrim is a gradient, not a flat
+// overlay, so the image still shows at the top of the card.
+import React from "react";
+import {
+  ImageBackground,
+  StyleSheet,
+  type ImageSourcePropType,
+  type StyleProp,
+  type ViewStyle,
+} from "react-native";
+import { LinearGradient } from "expo-linear-gradient";
+
+type Props = {
+  source: ImageSourcePropType;
+  style?: StyleProp<ViewStyle>;
+  /** Padding / alignment for the content inside the scrim. */
+  contentStyle?: StyleProp<ViewStyle>;
+  children?: React.ReactNode;
+};
+
+export function CardBackground({ source, style, contentStyle, children }: Props) {
+  return (
+    <ImageBackground source={source} style={[styles.bg, style]} resizeMode="cover">
+      <LinearGradient
+        colors={["rgba(8,5,18,0.08)", "rgba(8,5,18,0.30)", "rgba(8,5,18,0.62)"]}
+        locations={[0, 0.45, 1]}
+        style={[styles.scrim, contentStyle]}
+      >
+        {children}
+      </LinearGradient>
+    </ImageBackground>
+  );
+}
+
+const styles = StyleSheet.create({
+  bg: { overflow: "hidden" },
+  scrim: { flex: 1 },
+});
diff --git a/bownd/components/ui/MemberCode.tsx b/bownd/components/ui/MemberCode.tsx
new file mode 100644
index 0000000..d69229c
--- /dev/null
+++ b/bownd/components/ui/MemberCode.tsx
@@ -0,0 +1,55 @@
+// bownd/components/ui/MemberCode.tsx
+// The signed-in member's REAL code: a QR code plus a Code 128 barcode,
+// both derived from the member's Firebase UID. The QR carries the
+// bownd://member/<uid> deep link; the barcode carries the bare UID (the
+// key a venue scanner resolves against the member's profile).
+// Guests see an honest sign-in prompt — never a code for someone who
+// is not signed in, never a hardcoded example code.
+import React from "react";
+import { StyleSheet, Text, View } from "react-native";
+import QRCode from "react-native-qrcode-svg";
+
+import { Barcode } from "./Barcode";
+
+type Props = {
+  uid?: string | null;
+  size?: number;
+};
+
+export function MemberCode({ uid, size = 160 }: Props) {
+  if (!uid) {
+    return (
+      <View style={styles.empty}>
+        <Text style={styles.emptyText}>Sign in to see your member code.</Text>
+      </View>
+    );
+  }
+  const qrValue = `bownd://member/${uid}`;
+  return (
+    <View style={styles.wrap}>
+      <View style={styles.qrBox}>
+        <QRCode value={qrValue} size={size} color="#111111" backgroundColor="#ffffff" />
+      </View>
+      <Barcode value={uid} width={260} height={56} />
+      <Text style={styles.memberId} numberOfLines={1}>
+        Member ID {uid}
+      </Text>
+      <Text style={styles.note}>Show this code at a venue to identify your Bownd account.</Text>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  wrap: { alignItems: "center", gap: 12 },
+  qrBox: {
+    padding: 12,
+    borderRadius: 14,
+    backgroundColor: "#ffffff",
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  memberId: { fontSize: 12, fontWeight: "800", color: "#221c2a" },
+  note: { fontSize: 12, color: "#514a5a", fontWeight: "700", textAlign: "center" },
+  empty: { paddingVertical: 12, alignItems: "center" },
+  emptyText: { fontSize: 13, color: "#514a5a", fontWeight: "700", textAlign: "center" },
+});
