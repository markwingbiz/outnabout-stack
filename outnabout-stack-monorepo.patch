diff --git a/bownd/components/EventCard.tsx b/bownd/components/EventCard.tsx
new file mode 100644
index 0000000..3c1aff3
--- /dev/null
+++ b/bownd/components/EventCard.tsx
@@ -0,0 +1,35 @@
+import React from "react";
+import { View, Text, StyleSheet } from "react-native";
+
+type Props = {
+  event: any;
+  venue?: any;
+};
+
+export default function EventCard({ event, venue }: Props) {
+  const title = String(event?.title ?? "Event");
+  const when = event?.startISO ? new Date(event.startISO).toLocaleString() : "";
+  const venueName = String(venue?.name ?? event?.venueId ?? "");
+
+  return (
+    <View style={styles.card}>
+      <Text style={styles.title}>{title}</Text>
+      {!!venueName && <Text style={styles.sub}>{venueName}</Text>}
+      {!!when && <Text style={styles.meta}>{when}</Text>}
+      {!!event?.priceLabel && <Text style={styles.meta}>{String(event.priceLabel)}</Text>}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  card: {
+    borderRadius: 22,
+    padding: 14,
+    backgroundColor: "rgba(255,255,255,0.08)",
+    borderWidth: 1,
+    borderColor: "rgba(210,170,255,0.22)",
+  },
+  title: { color: "rgba(255,255,255,0.95)", fontWeight: "900", fontSize: 16 },
+  sub: { marginTop: 6, color: "rgba(255,255,255,0.75)", fontWeight: "800" },
+  meta: { marginTop: 6, color: "rgba(255,255,255,0.65)", fontWeight: "700", fontSize: 12 },
+});
diff --git a/bownd/components/EventDetailsModal.tsx b/bownd/components/EventDetailsModal.tsx
new file mode 100644
index 0000000..c4bdab2
--- /dev/null
+++ b/bownd/components/EventDetailsModal.tsx
@@ -0,0 +1,65 @@
+import React from "react";
+import { Modal, View, Text, StyleSheet, Pressable } from "react-native";
+import { LinearGradient } from "expo-linear-gradient";
+
+type Props = {
+  visible: boolean;
+  onClose: () => void;
+  item: any | null;
+};
+
+export function EventDetailsModal({ visible, onClose, item }: Props) {
+  return (
+    <Modal visible={visible} transparent animationType="fade" onRequestClose={onClose}>
+      <View style={styles.backdrop}>
+        <View style={styles.sheet}>
+          <LinearGradient
+            colors={["rgba(255,255,255,0.10)", "rgba(0,0,0,0.10)"]}
+            start={{ x: 0.5, y: 0 }}
+            end={{ x: 0.5, y: 1 }}
+            style={StyleSheet.absoluteFill}
+          />
+          <Text style={styles.h1}>{String(item?.title ?? "Event")}</Text>
+          <Text style={styles.p}>{String(item?.venueId ?? "")}</Text>
+          <Text style={styles.p}>{item?.startISO ? new Date(item.startISO).toLocaleString() : ""}</Text>
+
+          <Pressable onPress={onClose} style={styles.btn}>
+            <Text style={styles.btnText}>Close</Text>
