+];
+
+// ---------------------------------------------------------------------------
+// Demo events (10) — start times computed dynamically, always future.
+// ---------------------------------------------------------------------------
+
+const SHOWCASE_EVENTS: ShowcaseEvent[] = [
+  {
+    id: "demo-event-pickleball",
