# Firebase config for Bownd (Expo).
# Copy to `.env` and fill in the real values from Firebase Console
# (Project settings -> Your apps). Never commit `.env`.
# These are the public client keys (not admin secrets) — they are
# inlined into the app bundle by Expo at build time.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
