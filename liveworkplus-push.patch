diff --git a/livework-plus/lib/push.ts b/livework-plus/lib/push.ts
new file mode 100644
index 0000000..407cb00
--- /dev/null
+++ b/livework-plus/lib/push.ts
@@ -0,0 +1,441 @@
+// Livework+ push notifications — client integration
+// (push-notifications-plan.md Part 1). Owns: permission state, Expo push
+// token capture/refresh, registration in the Supabase `push_tokens`
+// registry, per-category preferences, Android notification channels, and
+// notification-tap deep-link routing.
+//
+// Registry contract (plan §1.3): one row per account + app + device in
+// `push_tokens`, upserted on (account_id, app, device_id), scope
+// `operator`. The sender (the push-send Edge Function — the ONLY sender)
+// reads categories from the row, never from client claims at send time.
+//
+// PRIVACY (plan §2.3, hard rule): the private categories carry template
+// labels only. Notification text for them is generic ("Weekly check-in",
+// "Date night this week") and is produced server-side from a template
+// key — nothing personal is ever placed in a payload by this module, and
+// the private screens' content stays behind the operator's own sign-in.
+import { useEffect, useRef } from "react";
+import { Alert, Platform } from "react-native";
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import Constants from "expo-constants";
+import * as Notifications from "expo-notifications";
+import { supabase } from "./supabase";
+
+// ---------- Constants ----------
+
+export const PUSH_APP = "livework_plus" as const;
+export const PUSH_SCOPE = "operator" as const;
+
+export type PushCategoryDef = {
+  key: string;
+  label: string;
+  description: string;
+  /** Operator categories can be silenced by the operator (plan §2.3). */
+  locked: boolean;
+};
+
+export const PUSH_CATEGORIES: PushCategoryDef[] = [
+  {
+    key: "operator_duty",
+    label: "Operator alerts",
+    description:
+      "Approval queue, finished rework, grace and reconciliation anomalies, disputes, scanner health, and milestones.",
+    locked: false,
+  },
+  {
+    key: "operator_private",
+    label: "Private reminders",
+    description:
+      "Weekly check-in and planned-date reminders. Wording stays generic — no details ever appear in the notification itself.",
+    locked: false,
+  },
+];
+
+export type PushCategoryPrefs = Record<string, boolean>;
+
+export function defaultCategoryPrefs(): PushCategoryPrefs {
+  const out: PushCategoryPrefs = {};
+  for (const c of PUSH_CATEGORIES) out[c.key] = true;
+  return out;
+}
+
+const STORAGE = {
+  deviceId: "liveworkplus.push.device_id",
+  categories: "liveworkplus.push.categories",
+  asked: "liveworkplus.push.asked",
+  masterOff: "liveworkplus.push.master_off",
+} as const;
+
+// ---------- Device id (per install; survives token rotation) ----------
+
+function randomId(): string {
+  const c = (globalThis as { crypto?: { randomUUID?: () => string } }).crypto;
+  if (c?.randomUUID) return c.randomUUID();
+  const bytes = Array.from({ length: 16 }, () => Math.floor(Math.random() * 256));
+  bytes[6] = (bytes[6] & 0x0f) | 0x40;
+  bytes[8] = (bytes[8] & 0x3f) | 0x80;
+  const hex = bytes.map((b) => b.toString(16).padStart(2, "0")).join("");
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+let deviceIdCache: string | null = null;
+
+export async function getPushDeviceId(): Promise<string> {
+  if (deviceIdCache) return deviceIdCache;
+  try {
+    const existing = await AsyncStorage.getItem(STORAGE.deviceId);
+    if (existing) {
+      deviceIdCache = existing;
+      return existing;
+    }
+  } catch {
+    // Fall through and mint a fresh id.
+  }
+  const fresh = randomId();
+  deviceIdCache = fresh;
+  try {
+    await AsyncStorage.setItem(STORAGE.deviceId, fresh);
+  } catch {
+    // Non-fatal: the in-memory id still keys this session's row.
+  }
+  return fresh;
+}
+
+// ---------- Category preferences ----------
+
+export async function loadCategoryPrefs(): Promise<PushCategoryPrefs> {
+  const defaults = defaultCategoryPrefs();
+  try {
+    const raw = await AsyncStorage.getItem(STORAGE.categories);
+    if (!raw) return defaults;
+    const parsed = JSON.parse(raw) as Record<string, unknown>;
+    for (const c of PUSH_CATEGORIES) {
+      if (typeof parsed[c.key] === "boolean") defaults[c.key] = parsed[c.key] as boolean;
+    }
+    return defaults;
+  } catch {
+    return defaults;
+  }
+}
+
+let registrationAccountId: string | null = null;
+
+export async function saveCategoryPref(key: string, value: boolean): Promise<PushCategoryPrefs> {
+  const prefs = await loadCategoryPrefs();
+  prefs[key] = value;
+  try {
+    await AsyncStorage.setItem(STORAGE.categories, JSON.stringify(prefs));
+  } catch {
+    // The registry write-through below still records the choice.
+  }
+  if (supabase && registrationAccountId) {
+    try {
+      const deviceId = await getPushDeviceId();
+      await supabase
+        .from("push_tokens")
+        .update({ categories_enabled: prefs, updated_at: new Date().toISOString() })
+        .eq("account_id", registrationAccountId)
+        .eq("app", PUSH_APP)
+        .eq("device_id", deviceId);
+    } catch {
+      // Best-effort: local prefs re-sync on the next registration refresh.
+    }
+  }
+  return prefs;
+}
+
+// ---------- Permission ----------
+
+export type PushPermissionState = "granted" | "denied" | "undetermined";
+
+export async function getPushPermissionState(): Promise<PushPermissionState> {
+  try {
+    const { status } = await Notifications.getPermissionsAsync();
+    return status === "granted" ? "granted" : status === "denied" ? "denied" : "undetermined";
+  } catch {
+    return "undetermined";
+  }
+}
+
+export async function requestPushPermission(): Promise<PushPermissionState> {
+  try {
+    const { status } = await Notifications.requestPermissionsAsync();
+    return status === "granted" ? "granted" : status === "denied" ? "denied" : "undetermined";
+  } catch {
+    return "undetermined";
+  }
+}
+
+// ---------- Registration ----------
+
+function deviceTimezone(): string | null {
+  try {
+    return Intl.DateTimeFormat().resolvedOptions().timeZone ?? null;
+  } catch {
+    return null;
+  }
+}
+
+async function fetchExpoPushToken(): Promise<string | null> {
+  try {
+    const projectId =
+      (Constants.expoConfig?.extra?.eas as { projectId?: string } | undefined)?.projectId ??
+      Constants.easConfig?.projectId ??
+      undefined;
+    const result = await Notifications.getExpoPushTokenAsync(
+      projectId ? { projectId } : undefined,
+    );
+    return typeof result.data === "string" ? result.data : null;
+  } catch {
+    // Simulators, missing credentials, Expo Go — no token, no row.
+    return null;
+  }
+}
+
+/**
+ * Upserts this device's push_tokens row for the signed-in operator.
+ * No-ops (returns false) when Supabase is unconfigured, there is no
+ * account, permission is not granted, or no token is available.
+ */
+export async function registerPushToken(accountId: string | null): Promise<boolean> {
+  if (!supabase || !accountId) return false;
+  if (await isPushMasterOff()) return false;
+  const permission = await getPushPermissionState();
+  if (permission !== "granted") return false;
+  const token = await fetchExpoPushToken();
+  if (!token) return false;
+  const deviceId = await getPushDeviceId();
+  const prefs = await loadCategoryPrefs();
+  const now = new Date().toISOString();
+  const { error } = await supabase.from("push_tokens").upsert(
+    {
+      account_id: accountId,
+      account_scope: PUSH_SCOPE,
+      tenant_id: null,
+      app: PUSH_APP,
+      platform: Platform.OS === "ios" ? "ios" : "android",
+      device_id: deviceId,
+      expo_push_token: token,
+      categories_enabled: prefs,
+      permission_status: "granted",
+      device_timezone: deviceTimezone(),
+      app_version: Constants.expoConfig?.version ?? null,
+      last_seen_at: now,
+      updated_at: now,
+      disabled_at: null,
+    },
+    { onConflict: "account_id,app,device_id" },
+  );
+  if (error) return false;
+  registrationAccountId = accountId;
+  return true;
+}
+
+/** Removes this device's registry row (master notifications switch off). */
+export async function unregisterPushToken(accountId: string | null): Promise<void> {
+  await setPushMasterOff(true);
+  if (!supabase || !accountId) return;
+  const deviceId = await getPushDeviceId();
+  await supabase
+    .from("push_tokens")
+    .delete()
+    .eq("account_id", accountId)
+    .eq("app", PUSH_APP)
+    .eq("device_id", deviceId);
+  if (registrationAccountId === accountId) registrationAccountId = null;
+}
+
+// ---------- Master switch (Settings) ----------
+
+export async function setPushMasterOff(off: boolean): Promise<void> {
+  try {
+    await AsyncStorage.setItem(STORAGE.masterOff, off ? "1" : "0");
+  } catch {
+    // Non-fatal: the in-session registration state still applies.
+  }
+}
+
+async function isPushMasterOff(): Promise<boolean> {
+  try {
+    return (await AsyncStorage.getItem(STORAGE.masterOff)) === "1";
+  } catch {
+    return false;
+  }
+}
+
+export async function loadPushMasterOff(): Promise<boolean> {
+  return isPushMasterOff();
+}
+
+/** Master switch on: clear the off flag, ask if needed, register. */
+export async function enablePushNotifications(
+  accountId: string | null,
+): Promise<PushPermissionState> {
+  await setPushMasterOff(false);
+  let state = await getPushPermissionState();
+  if (state !== "granted") state = await requestPushPermission();
+  if (state === "granted") await registerPushToken(accountId);
+  return state;
+}
+
+// ---------- In-context permission ask (plan §1.2) ----------
+
+/**
+ * The one in-context ask, fired at first operator sign-in (this app's
+ * whole job is alerting the operator). At most once per install, only
+ * while permission is undetermined, never after a refusal — Settings
+ * carries the enable control instead.
+ */
+export async function maybeAskForPushPermission(accountId: string | null): Promise<void> {
+  let asked: string | null = null;
+  try {
+    asked = await AsyncStorage.getItem(STORAGE.asked);
+  } catch {
+    asked = null;
+  }
+  if (asked) return;
+  const state = await getPushPermissionState();
+  if (state !== "undetermined") return;
+  try {
+    await AsyncStorage.setItem(STORAGE.asked, new Date().toISOString());
+  } catch {
+    // Continue — worst case the ask repeats on a later sign-in.
+  }
+  Alert.alert("Turn on notifications?", "Approval requests and money alerts land here.", [
+    { text: "Not now", style: "cancel" },
+    {
+      text: "Turn on",
+      onPress: () => {
+        void (async () => {
+          const next = await requestPushPermission();
+          if (next === "granted" && accountId) await registerPushToken(accountId);
+        })();
+      },
+    },
+  ]);
+}
+
+// ---------- Deep links ----------
+
+const ALLOWED_ROUTE_PREFIXES = [
+  "/(tabs)/approvals",
+  "/(tabs)/approval-detail",
+  "/(tabs)/deliverables",
+  "/(tabs)/jobs",
+  "/(tabs)/job-detail",
+  "/(tabs)/funnels",
+  "/(tabs)/funnel-detail",
+  "/(tabs)/connections",
+  "/(tabs)/dates",
+  "/(tabs)/insights",
+  "/(tabs)/settings",
+  "/(tabs)/push-composer",
+  "/(tabs)/forge",
+  "/(tabs)/workers",
+  "/(tabs)/audit-log",
+  "/(tabs)/bownd",
+  "/(tabs)/suggestions",
+  "/(tabs)",
+] as const;
+
+const HOME_ROUTE = "/(tabs)";
+
+/**
+ * Validates a push payload's deep_link against Livework+'s real route
+ * table. Unknown or malformed links fall back to Home (plan §1.1) — a
+ * push tap never crashes and never opens an arbitrary URL.
+ */
+export function resolveDeepLink(data: unknown): string {
+  const link =
+    data && typeof data === "object" && typeof (data as { deep_link?: unknown }).deep_link === "string"
+      ? ((data as { deep_link: string }).deep_link as string)
+      : null;
+  if (!link || !link.startsWith("/") || link.startsWith("//")) {
+    if (link) console.warn("[push] Unrecognized deep link, falling back home:", link);
+    return HOME_ROUTE;
+  }
+  const path = link.split("?")[0];
+  const ok = ALLOWED_ROUTE_PREFIXES.some((p) => path === p || path.startsWith(`${p}/`));
+  if (!ok) {
+    console.warn("[push] Unrecognized deep link, falling back home:", link);
+    return HOME_ROUTE;
+  }
+  return link;
+}
+
+// ---------- Bootstrap hook ----------
+
+let handlerInstalled = false;
+
+function installForegroundHandler(): void {
+  if (handlerInstalled) return;
+  handlerInstalled = true;
+  Notifications.setNotificationHandler({
+    handleNotification: async () => ({
+      shouldShowBanner: true,
+      shouldShowList: true,
+      shouldPlaySound: false,
+      shouldSetBadge: false,
+    }),
+  });
+}
+
+async function installAndroidChannels(): Promise<void> {
+  if (Platform.OS !== "android") return;
+  for (const c of PUSH_CATEGORIES) {
+    try {
+      await Notifications.setNotificationChannelAsync(c.key, {
+        name: c.label,
+        importance: Notifications.AndroidImportance.HIGH,
+      });
+    } catch {
+      // Channel creation is best-effort; sends still work without it.
+    }
+  }
+}
+
+/**
+ * Mount once inside the root layout (within AuthProvider). Wires the
+ * foreground handler, Android channels, tap routing (warm + cold start),
+ * token capture on sign-in, token-rotation refresh, and the one-time
+ * first-sign-in permission ask.
+ */
+export function usePushBootstrap(
+  accountId: string | null,
+  navigate: (route: string) => void,
+): void {
+  const navigateRef = useRef(navigate);
+  navigateRef.current = navigate;
+
+  useEffect(() => {
+    installForegroundHandler();
+    void installAndroidChannels();
+
+    let alive = true;
+    Notifications.getLastNotificationResponseAsync()
+      .then((response) => {
+        if (alive && response) {
+          navigateRef.current(resolveDeepLink(response.notification.request.content.data));
+        }
+      })
+      .catch(() => {});
+
+    const responseSub = Notifications.addNotificationResponseReceivedListener((response) => {
+      navigateRef.current(resolveDeepLink(response.notification.request.content.data));
+    });
+    const tokenSub = Notifications.addPushTokenListener(() => {
+      if (registrationAccountId) void registerPushToken(registrationAccountId);
+    });
+    return () => {
+      alive = false;
+      responseSub.remove();
+      tokenSub.remove();
+    };
+  }, []);
+
+  useEffect(() => {
+    if (!accountId) return;
+    void registerPushToken(accountId);
+    void maybeAskForPushPermission(accountId);
+  }, [accountId]);
+}
diff --git a/livework-plus/lib/pushAdmin.ts b/livework-plus/lib/pushAdmin.ts
new file mode 100644
index 0000000..d96b39a
--- /dev/null
+++ b/livework-plus/lib/pushAdmin.ts
@@ -0,0 +1,333 @@
+// Admin push composer — client contract for the push-send Edge Function
+// (push-notifications-plan.md §1.7). The composer is a CLIENT of
+// push-send: it enqueues like every other sender; there is no second
+// sending path and the app never talks to the Expo Push API directly.
+//
+// CROSS-APP MODEL (§1.7): a draft's FIRST choice is the target app —
+// Bownd, Livework, or Livework+. Segments resolve within that app, and
+// deep-link options follow the TARGET app's routes (a Bownd push links
+// to Bownd events / offers / venues / campaigns, never to Livework+
+// screens).
+//
+// Access: the composer screen gates on the app's existing operator
+// pattern (checkIsOperator in lib/forge.ts) — operator (Mark) only
+// today; the admin model is deferred and no roles are invented here.
+// Every composer action is audit-logged server-side by push-send
+// (forge_audit_log is Edge-Function-written in this codebase).
+import { callForge, newIdempotencyKey } from "./forge";
+import { supabase } from "./supabase";
+import { fetchFunnels } from "./data";
+
+// ---------- Types ----------
+
+export type PushTargetApp = "bownd" | "livework" | "livework_plus";
+
+export const PUSH_TARGET_APPS: { key: PushTargetApp; label: string }[] = [
+  { key: "bownd", label: "Bownd" },
+  { key: "livework", label: "Livework" },
+  { key: "livework_plus", label: "Livework+" },
+];
+
+export type PushSegment = "all" | "paid" | "free" | "venues" | "specific";
+
+/** Segments offered per target app (§1.7 segment set, scoped to the app). */
+export function segmentsForApp(app: PushTargetApp): { key: PushSegment; label: string }[] {
+  switch (app) {
+    case "bownd":
+      return [
+        { key: "all", label: "All members" },
+        { key: "paid", label: "Paid members" },
+        { key: "free", label: "Free members" },
+        { key: "specific", label: "Specific accounts" },
+      ];
+    case "livework":
+      return [
+        { key: "all", label: "All venue accounts" },
+        { key: "venues", label: "Venue tenants" },
+        { key: "specific", label: "Specific accounts" },
+      ];
+    case "livework_plus":
+      return [
+        { key: "all", label: "All operator accounts" },
+        { key: "specific", label: "Specific accounts" },
+      ];
+  }
+}
+
+export type PushAudience = {
+  app: PushTargetApp;
+  segment: PushSegment;
+  /** Required when segment = 'specific': account ids in the TARGET app. */
+  account_ids?: string[];
+};
+
+export type PushSendClass = "marketing" | "transactional";
+
+/** Fixed list (§1.7) — there is no free-form "transactional" label. */
+export const TRANSACTIONAL_REASONS = [
+  { key: "event_change", label: "Event change" },
+  { key: "cancellation", label: "Cancellation" },
+  { key: "refund_notice", label: "Refund notice" },
+  { key: "service_notice", label: "Service notice" },
+  { key: "security_notice", label: "Security notice" },
+] as const;
+
+export type TransactionalReason = (typeof TRANSACTIONAL_REASONS)[number]["key"];
+
+/** Category opt-in bucket per target app (the sender enforces §1.6). */
+export function categoriesForApp(app: PushTargetApp): { key: string; label: string }[] {
+  switch (app) {
+    case "bownd":
+      return [
+        { key: "offers_campaigns", label: "Offers & campaigns" },
+        { key: "events_for_you", label: "Events for you" },
+        { key: "perks_drops", label: "Perks & drops" },
+        { key: "points", label: "Points" },
+      ];
+    case "livework":
+      return [
+        { key: "venue_sales", label: "Sales & placements" },
+        { key: "venue_reviews", label: "Reviews" },
+        { key: "venue_suggestions", label: "Event suggestions" },
+      ];
+    case "livework_plus":
+      return [{ key: "operator_duty", label: "Operator alerts" }];
+  }
+}
+
+export type PushDraft = {
+  title: string;
+  body: string;
+  audience: PushAudience;
+  /** Category opt-in bucket in the TARGET app. */
+  category: string;
+  send_class: PushSendClass;
+  /** Required when send_class = 'transactional'; stored on the log rows. */
+  reason?: TransactionalReason;
+  /** App-internal route in the TARGET app ("" = no link). */
+  deep_link: string;
+};
+
+export type AdminPushState = { admin_push_enabled: boolean };
+
+export type ScheduledPush = {
+  id: string;
+  title: string;
+  app: PushTargetApp;
+  segment: PushSegment;
+  send_at: string;
+  send_class: PushSendClass;
+};
+
+export type AdminPushHistoryRow = {
+  id: string;
+  title: string;
+  app: PushTargetApp;
+  segment: PushSegment | null;
+  recipients: number | null;
+  status: string;
+  created_at: string;
+};
+
+// ---------- push-send actions (the function's admin contract) ----------
+
+export async function fetchAdminPushState(): Promise<AdminPushState> {
+  const res = await callForge<{ admin_push_enabled?: unknown }>("push-send", {
+    action: "admin_state",
+  });
+  return { admin_push_enabled: res?.admin_push_enabled === true };
+}
+
+export async function fetchAudienceCount(
+  audience: PushAudience,
+  category: string,
+): Promise<number> {
+  const res = await callForge<{ recipients?: unknown }>("push-send", {
+    action: "audience_count",
+    audience,
+    category,
+  });
+  return typeof res?.recipients === "number" ? res.recipients : 0;
+}
+
+/** Test send to the operator's own registered device for the target app. */
+export async function sendAdminTestPush(draft: PushDraft): Promise<void> {
+  await callForge("push-send", { action: "test_send", draft });
+}
+
+export async function sendAdminPushNow(
+  draft: PushDraft,
+): Promise<{ send_id: string | null; recipients: number | null }> {
+  const res = await callForge<{ send_id?: unknown; recipients?: unknown }>("push-send", {
+    action: "send",
+    draft,
+    idempotency_key: newIdempotencyKey(),
+  });
+  return {
+    send_id: typeof res?.send_id === "string" ? res.send_id : null,
+    recipients: typeof res?.recipients === "number" ? res.recipients : null,
+  };
+}
+
+export async function scheduleAdminPush(
+  draft: PushDraft,
+  sendAtISO: string,
+): Promise<{ draft_id: string | null }> {
+  const res = await callForge<{ draft_id?: unknown }>("push-send", {
+    action: "schedule",
+    draft,
+    send_at: sendAtISO,
+    idempotency_key: newIdempotencyKey(),
+  });
+  return { draft_id: typeof res?.draft_id === "string" ? res.draft_id : null };
+}
+
+export async function cancelScheduledAdminPush(draftId: string): Promise<void> {
+  await callForge("push-send", { action: "cancel_schedule", draft_id: draftId });
+}
+
+export async function listScheduledAdminPushes(): Promise<ScheduledPush[]> {
+  const res = await callForge<{ drafts?: unknown }>("push-send", {
+    action: "list_scheduled",
+  });
+  const rows = Array.isArray(res?.drafts) ? (res.drafts as Record<string, unknown>[]) : [];
+  return rows.map((r) => ({
+    id: String(r.id ?? ""),
+    title: String(r.title ?? "Untitled"),
+    app: (typeof r.app === "string" ? r.app : "bownd") as PushTargetApp,
+    segment: (typeof r.segment === "string" ? r.segment : "all") as PushSegment,
+    send_at: String(r.send_at ?? ""),
+    send_class: (r.send_class === "transactional" ? "transactional" : "marketing") as PushSendClass,
+  }));
+}
+
+export async function listAdminPushHistory(limit = 20): Promise<AdminPushHistoryRow[]> {
+  const res = await callForge<{ sends?: unknown }>("push-send", {
+    action: "list_history",
+    limit,
+  });
+  const rows = Array.isArray(res?.sends) ? (res.sends as Record<string, unknown>[]) : [];
+  return rows.map((r) => ({
+    id: String(r.id ?? ""),
+    title: String(r.title ?? "Untitled"),
+    app: (typeof r.app === "string" ? r.app : "bownd") as PushTargetApp,
+    segment: (typeof r.segment === "string" ? r.segment : null) as PushSegment | null,
+    recipients: typeof r.recipients === "number" ? r.recipients : null,
+    status: String(r.status ?? ""),
+    created_at: String(r.created_at ?? ""),
+  }));
+}
+
+// ---------- Deep-link picker data (target app's real rows/routes) ----------
+
+export type PushLinkTarget = { id: string; label: string; route: string };
+
+export type PushLinkOptions = {
+  events: PushLinkTarget[];
+  venues: PushLinkTarget[];
+  campaigns: PushLinkTarget[];
+  /** Bundles have no table yet — always empty in v1 (honest empty state). */
+  offers: PushLinkTarget[];
+  screens: PushLinkTarget[];
+  error: string | null;
+};
+
+function screensForApp(app: PushTargetApp): PushLinkTarget[] {
+  switch (app) {
+    case "bownd":
+      return [
+        { id: "home", label: "Home", route: "/(tabs)/home" },
+        { id: "events", label: "Events", route: "/(tabs)/events" },
+        { id: "personal", label: "Personal (tickets & rewards)", route: "/(tabs)/personal" },
+        { id: "whats-close", label: "What's Close", route: "/whats-close" },
+      ];
+    case "livework":
+      return [
+        { id: "dashboard", label: "Dashboard", route: "/" },
+        { id: "venues", label: "My Venues", route: "/venues" },
+        { id: "redemptions", label: "Redemptions", route: "/redemptions" },
+        { id: "publish", label: "Publish to Bownd", route: "/publish" },
+      ];
+    case "livework_plus":
+      return [
+        { id: "home", label: "Home", route: "/(tabs)" },
+        { id: "approvals", label: "Approvals", route: "/(tabs)/approvals" },
+        { id: "funnels", label: "Funnels", route: "/(tabs)/funnels" },
+        { id: "jobs", label: "Jobs", route: "/(tabs)/jobs" },
+        { id: "settings", label: "Settings", route: "/(tabs)/settings" },
+      ];
+  }
+}
+
+/**
+ * Loads the picker's rows for the TARGET app. Event/venue/campaign
+ * routes follow the target app's route table (§1.7). push-send
+ * re-validates every deep link at enqueue time against the target app —
+ * an unresolvable route blocks the send there too.
+ */
+export async function fetchPushLinkOptions(app: PushTargetApp): Promise<PushLinkOptions> {
+  const out: PushLinkOptions = {
+    events: [],
+    venues: [],
+    campaigns: [],
+    offers: [],
+    screens: screensForApp(app),
+    error: null,
+  };
+  if (!supabase) {
+    out.error = "Supabase is not configured.";
+    return out;
+  }
+  try {
+    if (app === "bownd" || app === "livework") {
+      const [ev, ve] = await Promise.all([
+        supabase
+          .from("events")
+          .select("id, title, start_ts, status")
+          .order("start_ts", { ascending: false })
+          .limit(50),
+        supabase
+          .from("venues")
+          .select("id, name")
+          .order("name", { ascending: true })
+          .limit(50),
+      ]);
+      if (ev.error) throw new Error(ev.error.message);
+      if (ve.error) throw new Error(ve.error.message);
+      out.events = ((ev.data ?? []) as Record<string, unknown>[]).map((e) => {
+        const id = String(e.id ?? "");
+        return {
+          id,
+          label: String(e.title ?? "Untitled event"),
+          route:
+            app === "bownd"
+              ? `/detail?id=${encodeURIComponent(id)}&kind=event`
+              : "/",
+        };
+      });
+      out.venues = ((ve.data ?? []) as Record<string, unknown>[]).map((v) => {
+        const id = String(v.id ?? "");
+        return {
+          id,
+          label: String(v.name ?? "Unnamed venue"),
+          route:
+            app === "bownd"
+              ? `/detail?id=${encodeURIComponent(id)}&kind=venue`
+              : "/venues",
+        };
+      });
+    }
+    if (app === "bownd") {
+      const { funnels, error } = await fetchFunnels();
+      if (error) throw new Error(error);
+      out.campaigns = funnels.map((f) => ({
+        id: f.id,
+        label: f.name,
+        route: "/(tabs)/events",
+      }));
+    }
+  } catch (e) {
+    out.error = e instanceof Error ? e.message : "Could not load link options.";
+  }
+  return out;
+}
